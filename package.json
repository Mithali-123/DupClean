{
  "name": "dupclean-pro",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build --prefix frontend && electron-builder"
  },
  "build": {
    "appId": "com.dupclean.pro",
    "files": [
      "main.js",
      "frontend/dist/**/*"
    ],
        "extraResources": [
      {
        "from": "backend/dist/app",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
        "win": {
      "target": "nsis"
    },
    "msi": {
      "oneClick": false
    },
    "appx": {
      "publisherDisplayName": "DupClean Pro",
      "displayName": "DupClean Pro",
      "identityName": "com.dupclean.pro",
      "publisher": "CN=CF510F15-36DC-4494-86D1-7C13CEDD53F6",
      "capabilities": [
        "broadFileSystemAccess"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "docx-preview": "^0.3.7",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}

